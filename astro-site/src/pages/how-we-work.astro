---
import { Image } from 'astro:assets';
import CtaBanner from '../components/CtaBanner.astro';
import Container from '../components/primitives/Container.astro';
import Heading from '../components/primitives/Heading.astro';
import PricingCard from '../components/PricingCard.astro';
import ProcessStep from '../components/ProcessStep.astro';
import Section from '../components/primitives/Section.astro';
import Text from '../components/primitives/Text.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { SITE, buildAbsoluteUrl, getPrimaryBusinessSchema } from '../lib/site';
import blueWren from '../assets/images/blue-wren.webp';
import blueWrenTwo from '../assets/images/blue-wren-2.webp';
import blueWrenCouple from '../assets/images/blue-wren-couple.webp';
import swNotebook from '../assets/images/sw-notebook.png';
import swTeam from '../assets/images/sw-team.png';

const meta = {
  title: 'How We Work & Pricing',
  description:
    'Learn about our process and pricing approach for small business marketing consultancy.',
  canonicalPath: '/how-we-work',
};

const toolkitItems = [
  'Brand Audit - an honest overview of your current brand status and key improvements',
  '60-minute Marketing Planner - a six-month strategy blueprint and practical content plan',
  'Campaign Planning Tool - a structured approach for high-impact campaigns',
  'VA Brief Builder - a ready-to-use brief for social or marketing virtual assistants',
];

const processSteps = [
  {
    step: '01',
    title: 'Informal chat',
    description:
      'We start with a conversation to get clear on the heart of your brand: who you are, what you stand for, who you serve, and why it matters.',
  },
  {
    step: '02',
    title: 'Shape the strategy',
    description:
      'We use the Splendid Wren toolkit to turn clarity into a practical strategy with focused actions and strong priorities.',
  },
  {
    step: '03',
    title: 'Put into practice',
    description:
      'We translate strategy into real-world implementation, including messaging, content direction and channel decisions.',
  },
  {
    step: '04',
    title: 'Momentum building',
    description:
      'We refine what is working, adjust what is not, and keep strengthening your foundations so growth stays aligned and sustainable.',
  },
];

const pricingCards = [
  {
    title: 'Wren Lite',
    price: '$110 per month',
    description:
      'A simple online starting point with practical tools and a supportive community to build momentum.',
    image: blueWren,
    imageAlt: 'Blue wren on branch',
    features: [
      'Six month brand audit',
      'AI prompt and platform library',
      'Entry-level Splendid Wren Marketing Toolkit access',
      'Private think tank community chat room',
      'Monthly online group check-in',
    ],
  },
  {
    title: 'Foundation',
    price: '$440 per month',
    description:
      'For businesses ready to shape a strong brand with clear strategy, messaging and direction.',
    image: blueWrenTwo,
    imageAlt: 'Blue wren portrait',
    features: [
      'All benefits of Wren Lite',
      'Personalised brand book and style guide',
      'Splendid Wren Marketing Toolkit access',
      'Six monthly one-on-one check-in',
    ],
  },
  {
    title: 'Growth',
    price: '$770 per month',
    description:
      'For brands building momentum with AI systems that support execution without losing human voice.',
    image: blueWrenCouple,
    imageAlt: 'Blue wren pair',
    features: [
      'All benefits of Foundation',
      'Personalised AI agents aligned to your brand',
      'Human implementation support',
      'Monthly one-on-one check-in',
    ],
  },
];

const faqItems = [
  {
    question: 'What types of businesses do you work with?',
    answer:
      'We work mainly with Australian small businesses that need clearer positioning, practical marketing systems, and ongoing support that fits real-world budgets.',
  },
  {
    question: 'How long does it take to see progress?',
    answer:
      'Most clients see early clarity and execution improvements in the first month, then stronger momentum over three to six months as systems and messaging are refined.',
  },
  {
    question: 'Do you help with AI tools and implementation?',
    answer:
      'Yes. We help you use AI responsibly for planning and execution while keeping your brand voice human, consistent, and aligned with your strategy.',
  },
  {
    question: 'Can I start with a smaller package and upgrade later?',
    answer:
      'Yes. Many clients begin with Wren Lite or Foundation, then move up as their priorities and capacity grow.',
  },
  {
    question: 'How do I get started?',
    answer:
      'Start with the contact form and share your business context. We will review your goals, recommend a practical starting point, and outline clear next steps.',
  },
];

const structuredData = [
  getPrimaryBusinessSchema(),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Small business marketing consultancy',
    name: 'Small Business Marketing Consulting Services',
    provider: {
      '@id': `${SITE.siteUrl}/#business`,
    },
    areaServed: {
      '@type': 'Country',
      name: 'Australia',
    },
    url: buildAbsoluteUrl('/how-we-work'),
    offers: pricingCards.map((plan) => ({
      '@type': 'Offer',
      name: plan.title,
      price: plan.price.replace(/[^\d.]/g, ''),
      priceCurrency: 'AUD',
      availability: 'https://schema.org/InStock',
      url: buildAbsoluteUrl('/how-we-work'),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<PageLayout
  meta={meta}
  structuredData={structuredData}
  heroTitle="How We Work"
  heroDescription="At Splendid Wren Marketing, how we work is as important as what we deliver. We listen, learn your brand, build strategy and give you practical tools to thrive."
  heroImage={{ src: swTeam, alt: 'Splendid Wren team collaboration', wrapperClass: 'mx-auto w-3/5' }}
>
  <Section>
    <Container class="max-w-5xl">
      <Heading level={2} class="text-center">What Sets Us Apart</Heading>
      <div class="mt-6 space-y-4 text-body text-neutral-700">
        <p>
          Most marketing support still relies on scattered tools, outsourced help, or generic AI that does not
          really understand your brand. Splendid Wren Marketing combines clear strategy and human-designed foundations
          with a purpose-built AI toolkit designed for your business.
        </p>
        <p>
          Inside the toolkit you will find practical, time-saving tools that simplify day-to-day marketing and
          move ideas into action faster:
        </p>
        <ul class="space-y-2 pl-5 text-base">
          {toolkitItems.map((item) => (
            <li class="list-disc">{item}</li>
          ))}
        </ul>
        <p>
          The toolkit is always expanding based on client and community demand, with each tool designed for real
          small business life.
        </p>
        <p>
          For implementation examples, visit our
          <a href="/blog" class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
            {' '}marketing blog
          </a>
          {' '}or learn more
          <a href="/about" class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
            {' '}about our approach
          </a>.
        </p>
        <p>
          Looking for a specific solution? Explore
          <a href="/small-business-marketing-consultant-australia" class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
            {' '}small business marketing consulting
          </a>
          ,
          <a href="/ai-marketing-support-small-business" class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
            {' '}AI marketing support
          </a>
          , and
          <a href="/brand-strategy-small-business" class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
            {' '}brand strategy services
          </a>
          .
        </p>
      </div>
    </Container>
  </Section>

  <Section>
    <Container class="max-w-5xl">
      <figure class="mb-8 overflow-hidden rounded-2xl border border-neutral-200 shadow-card">
        <Image
          src={swNotebook}
          alt="Notebook planning session"
          widths={[760, 1200, 1600]}
          sizes="(min-width: 1024px) 80vw, 94vw"
          class="h-52 w-full object-cover md:h-72"
          loading="lazy"
        />
      </figure>
      <Heading level={2} class="text-center">Working With Splendid Wren Marketing</Heading>
      <Text class="mx-auto mt-4 max-w-4xl text-center text-body">
        When you work with Splendid Wren Marketing, you work with a human first. Foundation packages and above
        follow a practical four-step process.
      </Text>

      <div class="mt-10 space-y-10">
        {processSteps.map((step) => <ProcessStep {...step} />)}
      </div>
    </Container>
  </Section>

  <Section tone="white">
    <Container class="max-w-6xl">
      <header class="mx-auto mb-10 max-w-4xl text-center">
        <Heading level={2}>Pricing Guide</Heading>
        <Text class="mt-4 text-body">
          We keep pricing simple and transparent. Every package is designed to meet you at your stage of growth.
          All pricing includes GST.
        </Text>
      </header>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {pricingCards.map((card) => <PricingCard {...card} />)}
      </div>

      <Text class="mx-auto mt-7 max-w-4xl text-center text-sm md:text-base" muted>
        Pricing shown is for 12-month subscription packages. Looking for something different? Fill in the
        <a href="/contact" class="font-semibold text-brand-700 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
          {' '}contact form
        </a>
        {' '}and let's chat about what you need.
      </Text>
    </Container>
  </Section>

  <Section>
    <Container class="max-w-4xl">
      <header class="mx-auto text-center">
        <Heading level={2}>Frequently Asked Questions</Heading>
      </header>
      <dl class="mt-8 space-y-6">
        {faqItems.map((item) => (
          <div class="surface-card p-6">
            <dt class="text-lg font-semibold text-brand-900">{item.question}</dt>
            <dd class="mt-3 text-base leading-relaxed text-neutral-700">{item.answer}</dd>
          </div>
        ))}
      </dl>
    </Container>
  </Section>

  <CtaBanner
    title="Let us get started"
    description="Take our free online brand audit and see where your brand shines and where it could use more focus."
  />
</PageLayout>
