---
import CtaBanner from '../components/CtaBanner.astro';
import Container from '../components/primitives/Container.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import Heading from '../components/primitives/Heading.astro';
import Section from '../components/primitives/Section.astro';
import Text from '../components/primitives/Text.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { SITE, buildAbsoluteUrl, getPrimaryBusinessSchema } from '../lib/site';
import swReady from '../assets/images/sw-ready.png';

const meta = {
  title: 'Small Business Marketing Consultant Australia',
  description:
    'Work with a small business marketing consultant in Australia to clarify strategy, simplify execution, and grow with confidence.',
  canonicalPath: '/small-business-marketing-consultant-australia',
  keywords: [
    'small business marketing consultant australia',
    'marketing consultant for small business',
    'small business marketing strategy',
    'australian small business marketing',
  ],
};

const painPoints = [
  'You are active in marketing but unsure what is actually driving results.',
  'Your message changes across channels and your brand feels inconsistent.',
  'You do not have time to build systems while running day-to-day operations.',
  'You want AI support, but without losing trust, voice, or quality.',
];

const outcomes = [
  'A clear positioning statement your team can use everywhere.',
  'A practical marketing roadmap focused on the next 90 days.',
  'Simple campaign priorities that fit your real capacity.',
  'A repeatable workflow that keeps your brand voice consistent.',
];

const faqItems = [
  {
    question: 'Who is this service designed for?',
    answer:
      'This service is built for Australian small business owners who need strategic clarity and practical implementation support without agency complexity.',
  },
  {
    question: 'Do you provide both strategy and execution support?',
    answer:
      'Yes. We start with strategy and then help translate it into practical messaging, campaign priorities, and workflows that can actually be maintained.',
  },
  {
    question: 'How do I choose the right package?',
    answer:
      'You can compare package options on our How We Work page, then contact us for a tailored recommendation based on your goals and stage of growth.',
  },
];

const structuredData = [
  getPrimaryBusinessSchema(),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Small Business Marketing Consultant in Australia',
    serviceType: 'Small business marketing consulting',
    provider: {
      '@id': `${SITE.siteUrl}/#business`,
    },
    areaServed: {
      '@type': 'Country',
      name: 'Australia',
    },
    audience: {
      '@type': 'Audience',
      audienceType: 'Small business owners',
    },
    description:
      'Strategic and practical marketing consulting for Australian small businesses, including positioning, messaging, and implementation systems.',
    url: buildAbsoluteUrl('/small-business-marketing-consultant-australia'),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: buildAbsoluteUrl('/'),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Small Business Marketing Consultant Australia',
        item: buildAbsoluteUrl('/small-business-marketing-consultant-australia'),
      },
    ],
  },
];
---

<PageLayout
  meta={meta}
  structuredData={structuredData}
  heroTitle="Small Business Marketing Consultant in Australia"
  heroDescription="Clear strategy, practical systems, and human-first implementation support for Australian small businesses."
  heroCtaLabel="Contact Us"
  heroCtaHref="/contact"
  heroImage={{ src: swReady, alt: 'Small business team prepared with a clear marketing plan' }}
>
  <Section>
    <Container class="max-w-5xl">
      <div class="space-y-4 text-body text-neutral-700">
        <p>
          If you are searching for a small business marketing consultant in Australia, you likely do not need more
          noise. You need focus. We help business owners simplify strategy, sharpen messaging, and execute with more
          confidence.
        </p>
        <p>
          Our approach combines strong brand foundations with practical marketing workflows that fit real-world time,
          budget, and team constraints.
        </p>
      </div>
    </Container>
  </Section>

  <Section tone="white">
    <Container class="max-w-5xl">
      <Heading level={2}>Common Pain Points We Solve</Heading>
      <ul class="mt-5 space-y-2 pl-5 text-base text-neutral-700">
        {painPoints.map((item) => (
          <li class="list-disc">{item}</li>
        ))}
      </ul>
    </Container>
  </Section>

  <Section>
    <Container class="max-w-5xl">
      <Heading level={2}>What You Can Expect</Heading>
      <ul class="mt-5 space-y-2 pl-5 text-base text-neutral-700">
        {outcomes.map((item) => (
          <li class="list-disc">{item}</li>
        ))}
      </ul>
      <Text class="mt-6 text-body">
        Review our full process and package options on
        <a href="/how-we-work" class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
          {' '}How We Work
        </a>
        , then reach out through
        <a href="/contact" class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
          {' '}Contact
        </a>
        {' '}for a tailored recommendation.
      </Text>
      <Text class="mt-4 text-body">
        For practical implementation ideas, read
        <a href="/blog/no-more-marketing-mayhem" class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
          {' '}No More Marketing Mayhem
        </a>
        {' '}and
        <a href="/blog/what-marketing-and-mafs-have-in-common" class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
          {' '}What Marketing and MAFS Have in Common
        </a>
        .
      </Text>
    </Container>
  </Section>

  <Section tone="white">
    <Container class="max-w-4xl">
      <Heading level={2} class="text-center">Frequently Asked Questions</Heading>
      <FaqAccordion items={faqItems} />
    </Container>
  </Section>

  <CtaBanner
    title="Get clear on your next marketing move"
    description="Tell us where your brand feels stuck and we will recommend a practical starting point."
    ctaLabel="Contact Us"
    ctaHref="/contact"
  />
</PageLayout>
