---
import { randomUUID } from 'node:crypto';
import ContactForm from '../components/ContactForm.astro';
import Container from '../components/primitives/Container.astro';
import Section from '../components/primitives/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, buildAbsoluteUrl, getPrimaryBusinessSchema } from '../lib/site';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const submissionId = randomUUID();
const selectedPackage = Astro.url.searchParams.get('package') ?? '';

const meta = {
  title: 'Contact Us',
  description: 'Contact Splendid Wren Marketing for guidance for your small business.',
  canonicalPath: '/contact',
};

const structuredData = [
  getPrimaryBusinessSchema(),
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: `Contact ${SITE.name}`,
    url: buildAbsoluteUrl('/contact'),
    mainEntity: {
      '@id': `${SITE.siteUrl}/#business`,
    },
  },
];
---

<BaseLayout meta={meta} structuredData={structuredData}>
  <Section tone="white" class="relative overflow-hidden py-10 md:py-14">
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src="/media/contact-background-1024.webp"
        srcset="/media/contact-background-768.webp 768w, /media/contact-background-1024.webp 1024w"
        width="1024"
        height="1024"
        alt=""
        sizes="100vw"
        class="h-full w-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-brand-950/58"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-brand-950/72 via-brand-950/40 to-brand-950/66"></div>
    </div>
    <Container class="relative max-w-[84rem]">
      <ContactForm submissionId={submissionId} selectedPackage={selectedPackage} />
    </Container>
  </Section>
</BaseLayout>
