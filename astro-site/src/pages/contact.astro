---
import { Image } from 'astro:assets';
import ContactForm from '../components/ContactForm.astro';
import Container from '../components/primitives/Container.astro';
import Section from '../components/primitives/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, buildAbsoluteUrl, getPrimaryBusinessSchema } from '../lib/site';
import swWorkingTwo from '../assets/images/sw-working-2.png';

const meta = {
  title: 'Contact Us',
  description: 'Contact Splendid Wren Marketing for guidance for your small business.',
  canonicalPath: '/contact',
};

const structuredData = [
  getPrimaryBusinessSchema(),
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: `Contact ${SITE.name}`,
    url: buildAbsoluteUrl('/contact'),
    mainEntity: {
      '@id': `${SITE.siteUrl}/#business`,
    },
  },
];
---

<BaseLayout meta={meta} structuredData={structuredData}>
  <Section tone="white" class="relative overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <Image
        src={swWorkingTwo}
        alt=""
        widths={[768, 1280, 1920]}
        sizes="100vw"
        class="h-full w-full object-cover object-center"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-white/88"></div>
    </div>
    <Container class="relative max-w-6xl">
      <ContactForm />
    </Container>
  </Section>
</BaseLayout>
