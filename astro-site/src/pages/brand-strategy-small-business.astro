---
import CtaBanner from '../components/CtaBanner.astro';
import Container from '../components/primitives/Container.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import Heading from '../components/primitives/Heading.astro';
import Section from '../components/primitives/Section.astro';
import Text from '../components/primitives/Text.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { SITE, buildAbsoluteUrl, getPrimaryBusinessSchema } from '../lib/site';
import swExplain from '../assets/images/sw-explain.png';

const meta = {
  title: 'Brand Strategy for Small Business',
  description:
    'Brand strategy consulting for small business owners who need clearer positioning, messaging, and market differentiation.',
  canonicalPath: '/brand-strategy-small-business',
  keywords: [
    'brand strategy consultant small business',
    'brand positioning for small business',
    'small business brand strategy australia',
    'small business messaging strategy',
  ],
};

const frameworkItems = [
  'Brand audit to identify clarity gaps and growth blockers.',
  'Positioning framework that defines your unique market space.',
  'Messaging pillars to keep every channel consistent.',
  'Implementation roadmap with realistic milestones.',
];

const proofItems = [
  'Faster campaign decisions because the brand direction is clear.',
  'Better conversion from messaging that speaks to the right audience.',
  'Less rework across content, ads, and social channels.',
  'Stronger confidence when scaling with AI and team support.',
];

const faqItems = [
  {
    question: 'Why does brand strategy matter before tactics?',
    answer:
      'Without clear positioning and messaging, tactical marketing becomes inconsistent and expensive. Strategy gives every campaign a stronger foundation.',
  },
  {
    question: 'Can you help if we already have a brand?',
    answer:
      'Yes. We often work with established businesses to refine positioning, sharpen messaging, and align execution with current goals.',
  },
  {
    question: 'How quickly can we start?',
    answer:
      'Most clients begin with an initial discovery conversation, then we recommend the best starting package and timeline for implementation.',
  },
];

const structuredData = [
  getPrimaryBusinessSchema(),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Brand Strategy Consulting for Small Businesses',
    serviceType: 'Brand strategy consulting',
    provider: {
      '@id': `${SITE.siteUrl}/#business`,
    },
    areaServed: {
      '@type': 'Country',
      name: 'Australia',
    },
    audience: {
      '@type': 'Audience',
      audienceType: 'Small business owners',
    },
    description:
      'Brand positioning and messaging strategy for small businesses that want clearer differentiation and stronger long-term marketing outcomes.',
    url: buildAbsoluteUrl('/brand-strategy-small-business'),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: buildAbsoluteUrl('/'),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Brand Strategy for Small Business',
        item: buildAbsoluteUrl('/brand-strategy-small-business'),
      },
    ],
  },
];
---

<PageLayout
  meta={meta}
  structuredData={structuredData}
  heroTitle="Brand Strategy for Small Business Owners"
  heroDescription="Clarify your positioning, simplify your messaging, and create a brand foundation that supports sustainable growth."
  heroCtaLabel="Contact Us"
  heroCtaHref="/contact"
  heroImage={{ src: swExplain, alt: 'Brand strategy discussion and planning session' }}
>
  <Section>
    <Container class="max-w-5xl">
      <div class="space-y-4 text-body text-neutral-700">
        <p>
          Great marketing becomes easier when your brand strategy is clear. We help small business owners define what
          they stand for, who they serve best, and how to communicate that consistently across channels.
        </p>
        <p>
          The result is less guesswork, stronger differentiation, and messaging that drives better decisions every
          week.
        </p>
      </div>
    </Container>
  </Section>

  <Section tone="white">
    <Container class="max-w-5xl">
      <Heading level={2}>Our Brand Strategy Framework</Heading>
      <ul class="mt-5 space-y-2 pl-5 text-base text-neutral-700">
        {frameworkItems.map((item) => (
          <li class="list-disc">{item}</li>
        ))}
      </ul>
    </Container>
  </Section>

  <Section>
    <Container class="max-w-5xl">
      <Heading level={2}>Outcomes You Can Measure</Heading>
      <ul class="mt-5 space-y-2 pl-5 text-base text-neutral-700">
        {proofItems.map((item) => (
          <li class="list-disc">{item}</li>
        ))}
      </ul>
      <Text class="mt-6 text-body">
        Explore package options and process details on
        <a href="/how-we-work" class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
          {' '}How We Work
        </a>
        , then use
        <a href="/contact" class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
          {' '}Contact
        </a>
        {' '}to discuss your brand priorities.
      </Text>
      <Text class="mt-4 text-body">
        For deeper context, read
        <a href="/blog/marketing-clarity-for-small-brands" class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
          {' '}Marketing Clarity for Small Brands
        </a>
        {' '}and
        <a href="/blog/brand-positioning-checklist-for-small-business-owners" class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
          {' '}Brand Positioning Checklist for Small Business Owners
        </a>
        .
      </Text>
    </Container>
  </Section>

  <Section tone="white">
    <Container class="max-w-4xl">
      <Heading level={2} class="text-center">Frequently Asked Questions</Heading>
      <FaqAccordion items={faqItems} />
    </Container>
  </Section>

  <CtaBanner
    title="Get brand clarity before scaling"
    description="Start with a practical brand strategy conversation tailored to your business stage."
    ctaLabel="Contact Us"
    ctaHref="/contact"
  />
</PageLayout>
