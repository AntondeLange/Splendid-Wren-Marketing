---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/primitives/Button.astro';
import Card from '../components/primitives/Card.astro';
import Container from '../components/primitives/Container.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Heading from '../components/primitives/Heading.astro';
import Section from '../components/primitives/Section.astro';
import Text from '../components/primitives/Text.astro';
import heroPoster from '../assets/images/blue-wren-couple.webp';
import swCoffee from '../assets/images/sw-coffee.png';
import { SITE, getPrimaryBusinessSchema } from '../lib/site';

const meta = {
  title: 'Splendid Wren Marketing | Small Business Marketing Consultancy',
  description:
    'Warm, clear, and human-focused marketing guidance for small businesses in Australia.',
  canonicalPath: '/',
};

const trustItems = [
  {
    title: 'Based in Australia',
    description: 'Local insight with a global outlook.',
  },
  {
    title: 'Small business focused',
    description: 'Clear strategy built for real-world constraints.',
  },
  {
    title: 'Human-first marketing',
    description: 'AI-aware, but always authentic.',
  },
];

const helpItems = [
  {
    title: 'Clear Strategy',
    description:
      'We cut through the noise and bring focus to what actually matters. Together, we uncover the heart of your brand and build a clear direction so every decision, message and action makes sense.',
    href: '/how-we-work',
  },
  {
    title: 'Practical Guidance',
    description:
      'No jargon. No overwhelm. Just real advice and simple tools that are useful. We break ideas into practical steps so your marketing feels doable.',
    href: '/contact',
  },
  {
    title: 'Human-Centered',
    description:
      'Your brand is built by a real person. We learn your story, values and goals, then shape marketing that sounds like you and connects with the right people.',
    href: '/about',
  },
  {
    title: 'Long-Term Growth',
    description:
      'We are not here for quick fixes. We help you build strong foundations and steady momentum so your business stays relevant and resilient.',
    href: '/blog',
  },
];

const structuredData = [
  getPrimaryBusinessSchema(),
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.siteUrl}/#website`,
    url: `${SITE.siteUrl}/`,
    name: SITE.name,
    inLanguage: 'en-AU',
    publisher: {
      '@id': `${SITE.siteUrl}/#business`,
    },
  },
];
---

<BaseLayout meta={meta} structuredData={structuredData}>
  <Fragment slot="head">
    <script is:inline>
      (() => {
        const currentUrl = new URL(window.location.href);
        const fromValue = currentUrl.searchParams.get('from');

        if (fromValue === 'loader') {
          sessionStorage.setItem('loaderShown', 'true');
          currentUrl.searchParams.delete('from');
          const cleanPath = `${currentUrl.pathname}${currentUrl.search}${currentUrl.hash}`;
          window.history.replaceState({}, document.title, cleanPath || '/');
          return;
        }

        if (sessionStorage.getItem('loaderShown') === 'true') {
          return;
        }

        window.location.replace('/loader');
      })();
    </script>
  </Fragment>

  <section class="hero-section relative isolate flex min-h-[78vh] items-center overflow-hidden bg-brand-900">
    <video
      data-hero-video
      class="absolute inset-0 h-full w-full object-cover opacity-35"
      muted
      playsinline
      preload="none"
      poster={heroPoster.src}
    >
      <source src="/media/hero-wren.webm" type="video/webm" />
    </video>
    <div class="absolute inset-0 bg-gradient-to-b from-brand-950/35 via-brand-900/60 to-brand-900/70"></div>

    <Container class="relative z-10">
      <div class="mx-auto max-w-4xl py-24 text-center text-white md:py-30">
        <Heading level={1} class="text-display text-white">Marketing Solutions That Sing</Heading>
        <Text class="mx-auto mt-6 max-w-3xl text-xl text-white/90 md:text-2xl">
          Building clear, confident, human brands that thrive in an AI-powered world.
        </Text>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <Button href="/contact" variant="inverse" class="sm:min-w-[12rem]">Contact Us</Button>
          <Button href="/how-we-work" variant="outline" class="border-white text-white hover:border-white hover:bg-white hover:text-brand-900 sm:min-w-[12rem]">
            Learn More
          </Button>
        </div>
        <p class="mt-4 text-sm font-medium tracking-wide text-white/80">
          Based in Australia | Small business focused
        </p>
      </div>
    </Container>
  </section>

  <Section tone="white" class="border-y border-neutral-200">
    <Container>
      <div class="grid gap-8 text-center md:grid-cols-3">
        {trustItems.map((item) => (
          <div>
            <p class="text-base font-semibold text-brand-900">{item.title}</p>
            <p class="mt-1 text-sm text-neutral-700">{item.description}</p>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="white">
    <Container>
      <header class="mx-auto mb-12 max-w-3xl text-center">
        <Heading level={2}>How We Help</Heading>
        <Text class="mt-4 text-body">
          The world is getting louder, faster and less human. Clarity and a small brand's place in the world
          is the most valuable marketing asset they can have. Let us uncover yours.
        </Text>
      </header>

      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {helpItems.map((item) => (
          <Card class="h-full">
            <Heading level={3} class="text-2xl">{item.title}</Heading>
            <Text class="mt-4">{item.description}</Text>
            <a href={item.href} class="mt-5 inline-flex text-sm font-semibold text-brand-800 hover:text-brand-950">
              Learn more
            </a>
          </Card>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="soft">
    <Container class="max-w-5xl">
      <div class="grid gap-5 text-center md:grid-cols-3">
        <a
          href="/how-we-work"
          class="surface-card p-6 text-left transition hover:-translate-y-0.5 hover:shadow-glow"
        >
          <p class="text-sm font-semibold uppercase tracking-[0.08em] text-brand-700">Services</p>
          <p class="mt-2 text-lg font-semibold text-brand-900">Explore How We Work and Pricing</p>
          <p class="mt-2 text-sm text-neutral-700">See process details, package options, and implementation steps.</p>
        </a>
        <a
          href="/about"
          class="surface-card p-6 text-left transition hover:-translate-y-0.5 hover:shadow-glow"
        >
          <p class="text-sm font-semibold uppercase tracking-[0.08em] text-brand-700">About</p>
          <p class="mt-2 text-lg font-semibold text-brand-900">Read The Founder Story</p>
          <p class="mt-2 text-sm text-neutral-700">Learn who we help and why our approach is human-first.</p>
        </a>
        <a
          href="/blog"
          class="surface-card p-6 text-left transition hover:-translate-y-0.5 hover:shadow-glow"
        >
          <p class="text-sm font-semibold uppercase tracking-[0.08em] text-brand-700">Insights</p>
          <p class="mt-2 text-lg font-semibold text-brand-900">Browse The Marketing Blog</p>
          <p class="mt-2 text-sm text-neutral-700">Practical guides for small business marketing in Australia.</p>
        </a>
      </div>
    </Container>
  </Section>

  <Section tone="white" class="relative overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <Image
        src={swCoffee}
        alt=""
        widths={[768, 1280, 1920]}
        sizes="100vw"
        class="h-full w-full object-cover object-center"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-white/88 backdrop-blur-[1px]"></div>
    </div>
    <Container class="relative">
      <div class="mx-auto max-w-4xl text-center">
        <p class="font-accent text-3xl italic text-brand-900">
          "Marketing becomes simple when a business understands who they really are."
        </p>
        <Text class="mt-5 text-body">
          At Splendid Wren Marketing, we help small business owners uncover that clarity and use modern tools
          to express their brand with purpose, confidence and humanity without losing the heart behind the business.
        </Text>
      </div>
    </Container>
  </Section>

  <CtaBanner />

  <script is:inline>
    (() => {
      const initHeroEffects = () => {
        const heroSection = document.querySelector('.hero-section');
        const heroVideo = document.querySelector('[data-hero-video]');

        if (!(heroSection instanceof HTMLElement) || !(heroVideo instanceof HTMLVideoElement)) {
          return;
        }

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const prefersReducedData = window.matchMedia('(prefers-reduced-data: reduce)').matches;
        const hasFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

        if (prefersReducedMotion || prefersReducedData) {
          return;
        }

        const startPlayback = () => {
          heroVideo.autoplay = true;
          heroVideo.loop = true;
          heroVideo.play().catch(() => {});
        };

        if (!('IntersectionObserver' in window)) {
          startPlayback();
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) {
              return;
            }

            observer.disconnect();

            if ('requestIdleCallback' in window) {
              window.requestIdleCallback(() => {
                startPlayback();
              }, { timeout: 1000 });
            } else {
              window.setTimeout(startPlayback, 250);
            }
          },
          {
            threshold: 0.35,
          }
        );

        observer.observe(heroSection);

        const rippleContainer = document.createElement('div');
        rippleContainer.className = 'hero-ripple-container';
        heroSection.appendChild(rippleContainer);

        const chirpAudio = new Audio('/media/blue-wren-audio.mp3');
        chirpAudio.preload = 'metadata';
        chirpAudio.volume = 0.28;

        const RIPPLE_INTERVAL_MS = 140;
        const CHIRP_INTERVAL_MS = 1800;
        const MAX_RIPPLES = 8;

        let audioUnlocked = false;
        let pointerInside = false;
        let lastRippleAt = 0;
        let lastChirpAt = 0;
        let pendingX = 0;
        let pendingY = 0;
        let rafId = 0;

        const addRipple = (x, y) => {
          if (rippleContainer.childElementCount >= MAX_RIPPLES) {
            rippleContainer.firstElementChild?.remove();
          }

          const ripple = document.createElement('span');
          ripple.className = 'hero-ripple';
          ripple.style.left = `${x}px`;
          ripple.style.top = `${y}px`;
          rippleContainer.appendChild(ripple);
          ripple.addEventListener('animationend', () => ripple.remove(), { once: true });
        };

        const tryUnlockAudio = () => {
          if (audioUnlocked) {
            return;
          }

          chirpAudio
            .play()
            .then(() => {
              chirpAudio.pause();
              chirpAudio.currentTime = 0;
              audioUnlocked = true;
            })
            .catch(() => {});
        };

        const maybePlayChirp = () => {
          if (!audioUnlocked) {
            return;
          }

          const now = performance.now();
          if (now - lastChirpAt < CHIRP_INTERVAL_MS) {
            return;
          }

          lastChirpAt = now;
          chirpAudio.currentTime = 0;
          chirpAudio.play().catch(() => {});
        };

        const maybeRenderRipple = () => {
          rafId = 0;

          if (!pointerInside) {
            return;
          }

          const now = performance.now();
          if (now - lastRippleAt < RIPPLE_INTERVAL_MS) {
            return;
          }

          lastRippleAt = now;
          addRipple(pendingX, pendingY);
        };

        const updatePointerPosition = (event) => {
          const rect = heroSection.getBoundingClientRect();
          pendingX = event.clientX - rect.left;
          pendingY = event.clientY - rect.top;
        };

        const handlePointerEnter = (event) => {
          pointerInside = true;
          tryUnlockAudio();
          updatePointerPosition(event);
          addRipple(pendingX, pendingY);
          maybePlayChirp();
        };

        const handlePointerMove = (event) => {
          updatePointerPosition(event);
          if (rafId === 0) {
            rafId = window.requestAnimationFrame(maybeRenderRipple);
          }
        };

        const handlePointerDown = (event) => {
          tryUnlockAudio();
          updatePointerPosition(event);
          addRipple(pendingX, pendingY);
          maybePlayChirp();
        };

        const handlePointerLeave = () => {
          pointerInside = false;
        };

        document.addEventListener('pointerdown', tryUnlockAudio, { once: true, passive: true });
        document.addEventListener('keydown', tryUnlockAudio, { once: true });
        heroSection.addEventListener('pointerdown', handlePointerDown, { passive: true });

        if (hasFinePointer) {
          heroSection.addEventListener('pointerenter', handlePointerEnter);
          heroSection.addEventListener('pointermove', handlePointerMove, { passive: true });
          heroSection.addEventListener('pointerleave', handlePointerLeave);
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initHeroEffects, { once: true });
      } else {
        initHeroEffects();
      }
    })();
  </script>
</BaseLayout>
