---
import { Image } from 'astro:assets';
import CtaBanner from '../components/CtaBanner.astro';
import Container from '../components/primitives/Container.astro';
import Heading from '../components/primitives/Heading.astro';
import Section from '../components/primitives/Section.astro';
import Text from '../components/primitives/Text.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { SITE, buildAbsoluteUrl, getPrimaryBusinessSchema } from '../lib/site';
import swAgree from '../assets/images/sw-agree.png';
import swExplain from '../assets/images/sw-explain.png';
import swWorkingTwo from '../assets/images/sw-working-2.png';
import headshotCuppa from '../assets/images/headshot-cuppa.webp';

const meta = {
  title: 'About Us',
  description:
    'Learn about Splendid Wren Marketing and our purpose-driven approach to helping small businesses.',
  canonicalPath: '/about',
};

const structuredData = [
  getPrimaryBusinessSchema(),
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: `About ${SITE.name}`,
    url: buildAbsoluteUrl('/about'),
    isPartOf: {
      '@id': `${SITE.siteUrl}/#website`,
    },
    about: {
      '@id': `${SITE.siteUrl}/#business`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: buildAbsoluteUrl('/'),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'About',
        item: buildAbsoluteUrl('/about'),
      },
    ],
  },
];
---

<PageLayout
  meta={meta}
  structuredData={structuredData}
  heroTitle="About"
  heroDescription="Splendid Wren Marketing was created from a simple belief: small businesses deserve brands that feel clear, confident and truly their own."
  heroImage={{ src: swExplain, alt: 'Splendid Wren team discussing strategy' }}
>
  <Section>
    <Container>
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <figure class="overflow-hidden rounded-xl border border-neutral-200 shadow-card">
          <Image
            src={headshotCuppa}
            alt="Founder headshot"
            widths={[560, 860]}
            sizes="(min-width: 1024px) 34vw, 100vw"
            loading="lazy"
          />
        </figure>

        <article>
          <Heading level={2}>Founder Story</Heading>
          <div class="mt-4 space-y-4 text-base leading-relaxed text-neutral-700">
            <p>
              Meet Sarah Moore. After more than 20 years working alongside small business owners, it became
              clear that many were not short on ideas or ambition. They were overwhelmed by noise.
            </p>
            <p>
              Marketing is easier when you have strong foundations. With clear positioning and practical tools,
              technology can do the heavy lifting.
            </p>
            <p>
              Over the past two years, Sarah has focused deeply on AI and practical marketing systems. She left
              a stable corporate path to build tools that help small businesses simplify marketing and grow with confidence.
            </p>
            <p>
              Want to see this in action? Explore
              <a href="/how-we-work" class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
                {' '}how we work
              </a>
              {' '}or start a conversation through our
              <a href="/contact" class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
                {' '}contact page
              </a>.
            </p>
          </div>
        </article>
      </div>
    </Container>
  </Section>

  <Section tone="white" class="relative overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <Image
        src={swWorkingTwo}
        alt=""
        widths={[768, 1280, 1600]}
        sizes="100vw"
        class="h-full w-full object-cover object-center"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-white/90"></div>
    </div>
    <Container class="relative max-w-4xl">
      <Heading level={2} class="text-center">Our Purpose</Heading>
      <div class="mt-6 space-y-4 text-body text-neutral-700">
        <p>We believe a business does not need to be big to deserve a brand that stands out.</p>
        <p>
          Our purpose is to bring clarity, confidence and meaning to small business people building something real.
          When a business understands who they are, everything else becomes possible.
        </p>
        <p>
          We show up with optimism, insight, innovation and honesty so clients can express their brand with
          purpose and personality in a fast-moving world.
        </p>
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <article>
          <Heading level={2}>Why Splendid Wren?</Heading>
          <Text class="mt-4 text-body">
            The name reflects what great brands can be: small but unmistakable. The splendid wren is vibrant,
            clear and impossible to ignore in its natural environment. That is our approach to brand work.
          </Text>
          <Text class="mt-4 text-base text-neutral-700">
            For practical examples, read our
            <a href="/blog" class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
              {' '}latest blog insights
            </a>.
          </Text>
          <Text class="mt-4 text-base text-neutral-700">
            You can also explore our focused services for
            <a href="/small-business-marketing-consultant-australia" class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
              {' '}small business marketing consulting
            </a>
            ,
            <a href="/ai-marketing-support-small-business" class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
              {' '}AI marketing support
            </a>
            , and
            <a href="/brand-strategy-small-business" class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950">
              {' '}brand strategy
            </a>
            .
          </Text>
        </article>

        <figure class="overflow-hidden rounded-xl border border-neutral-200 shadow-card">
          <Image
            src={swAgree}
            alt="Splendid Wren brand imagery"
            widths={[560, 860]}
            sizes="(min-width: 1024px) 34vw, 100vw"
            loading="lazy"
          />
        </figure>
      </div>
    </Container>
  </Section>

  <CtaBanner />
</PageLayout>
