---
import { getCollection } from 'astro:content';
import BlogCard from '../../components/BlogCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Container from '../../components/primitives/Container.astro';
import Heading from '../../components/primitives/Heading.astro';
import Section from '../../components/primitives/Section.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import Text from '../../components/primitives/Text.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import blueWren2 from '../../assets/images/blue-wren-2.webp';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const meta = {
  title: 'Blog',
  description: 'Practical, thoughtful marketing insights for small businesses.',
  canonicalPath: '/blog',
};
---

<PageLayout
  meta={meta}
  heroTitle="Blog"
  heroDescription="Practical, thoughtful marketing insights for small businesses."
  heroImage={{ src: blueWren2, alt: 'Blue wren bird' }}
>
  <Section>
    <Container>
      {posts.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2">
          {posts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              href={`/blog/${post.slug}`}
              publishDate={post.data.publishDate}
            />
          ))}
        </div>
      ) : (
        <div class="mx-auto max-w-3xl rounded-xl border border-neutral-200 bg-white p-8 text-center shadow-card">
          <Heading level={2}>New articles coming soon</Heading>
          <Text class="mt-3 text-body">
            We are preparing practical, human-focused marketing insights for small business owners.
          </Text>
        </div>
      )}
    </Container>
  </Section>

  <Section>
    <Container class="max-w-4xl text-center">
      <Heading level={2}>Follow Us On Social Media</Heading>
      <SocialLinks variant="large" class="mt-8" />
    </Container>
  </Section>

  <CtaBanner />
</PageLayout>
