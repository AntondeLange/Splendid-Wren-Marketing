---
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import BlogCard from '../../components/BlogCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Container from '../../components/primitives/Container.astro';
import Heading from '../../components/primitives/Heading.astro';
import Section from '../../components/primitives/Section.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import Text from '../../components/primitives/Text.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE } from '../../lib/site';
import headshotBridge from '../../assets/images/headshot-bridge.webp';
import swAgree from '../../assets/images/sw-agree.png';
import swCoffee from '../../assets/images/sw-coffee.png';
import swExplain from '../../assets/images/sw-explain.png';
import swNotebook from '../../assets/images/sw-notebook.png';
import swReady from '../../assets/images/sw-ready.png';
import swTeam from '../../assets/images/sw-team.png';
import swTogether from '../../assets/images/sw-together.png';
import swWorkingTwo from '../../assets/images/sw-working-2.png';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const meta = {
  title: 'Blog',
  description: 'Practical, thoughtful marketing insights for small businesses.',
  canonicalPath: '/blog',
  keywords: [
    'small business marketing blog australia',
    'marketing strategy insights',
    'human first marketing',
    'ai marketing for small business',
  ],
};

const blogUrl = `${SITE.siteUrl}/blog`;

const postCardImages: Record<string, { image: ImageMetadata; imageAlt: string }> = {
  '7-marketing-priorities-for-australian-small-businesses': {
    image: swNotebook,
    imageAlt: 'Notebook and planning materials on a desk',
  },
  'ai-marketing-workflow-from-prompt-to-publish': {
    image: swWorkingTwo,
    imageAlt: 'Team workflow and planning session',
  },
  'brand-positioning-checklist-for-small-business-owners': {
    image: swExplain,
    imageAlt: 'Person explaining brand strategy concepts',
  },
  'how-small-businesses-can-use-ai-without-losing-their-voice': {
    image: swTeam,
    imageAlt: 'Small team collaborating closely',
  },
  'how-to-describe-your-business-in-one-sentence': {
    image: swCoffee,
    imageAlt: 'Coffee and notes during a messaging workshop',
  },
  'what-to-fix-first-when-your-marketing-feels-scattered': {
    image: swAgree,
    imageAlt: 'Two people aligned on next priorities',
  },
  'marketing-clarity-for-small-brands': {
    image: swReady,
    imageAlt: 'Team prepared and ready to start',
  },
  'human-first-marketing-in-an-ai-world': {
    image: swTogether,
    imageAlt: 'Team collaborating together',
  },
};

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': `${blogUrl}#blog`,
    name: `${SITE.name} Blog`,
    url: blogUrl,
    inLanguage: 'en-AU',
    publisher: {
      '@id': `${SITE.siteUrl}/#business`,
    },
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      datePublished: post.data.publishDate.toISOString(),
      dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
      url: `${SITE.siteUrl}/blog/${post.slug}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${blogUrl}#collection`,
    name: `${SITE.name} Blog`,
    url: blogUrl,
    isPartOf: {
      '@id': `${SITE.siteUrl}/#website`,
    },
    about: {
      '@id': `${blogUrl}#blog`,
    },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: posts.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `${SITE.siteUrl}/blog/${post.slug}`,
        name: post.data.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: `${SITE.siteUrl}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blog',
        item: blogUrl,
      },
    ],
  },
];
---

<PageLayout
  meta={meta}
  structuredData={structuredData}
  heroTitle="Blog"
  heroDescription="Practical, thoughtful marketing insights for small businesses."
  heroCtaLabel="Contact Us"
  heroCtaHref="/contact"
  heroImage={{ src: headshotBridge, alt: 'Splendid Wren brand imagery', wrapperClass: 'mx-auto w-3/5' }}
>
  <Section>
    <Container>
      {posts.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2">
          {posts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              href={`/blog/${post.slug}`}
              publishDate={post.data.publishDate}
              image={postCardImages[post.slug]?.image}
              imageAlt={postCardImages[post.slug]?.imageAlt}
            />
          ))}
        </div>
      ) : (
        <div class="mx-auto max-w-3xl rounded-xl border border-neutral-200 bg-white p-8 text-center shadow-card">
          <Heading level={2}>New articles coming soon</Heading>
          <Text class="mt-3 text-body">
            We are preparing practical, human-focused marketing insights for small business owners.
          </Text>
        </div>
      )}
    </Container>
  </Section>

  <Section>
    <Container class="max-w-4xl text-center">
      <Heading level={2}>Follow Us On Social Media</Heading>
      <SocialLinks variant="large" class="mt-8" />
    </Container>
  </Section>

  <CtaBanner />
</PageLayout>
