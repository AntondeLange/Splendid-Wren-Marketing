---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BlogCard from '../../components/BlogCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Container from '../../components/primitives/Container.astro';
import Heading from '../../components/primitives/Heading.astro';
import Section from '../../components/primitives/Section.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import Text from '../../components/primitives/Text.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { BLOG_IMAGES } from '../../lib/blogImages';
import { SITE } from '../../lib/site';
import headshotBridge from '../../assets/images/headshot-bridge.webp';

const getPostSlug = (post: CollectionEntry<'blog'>) => post.id.replace(/\.(md|mdx)$/i, '');

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const meta = {
  title: 'Blog',
  description: 'Launch stories, brand strategy insights, and practical marketing advice for small businesses.',
  canonicalPath: '/blog',
  keywords: [
    'small business marketing blog australia',
    'brand foundation',
    'small business marketing support',
    'marketing strategy insights',
  ],
};

const blogUrl = `${SITE.siteUrl}/blog`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': `${blogUrl}#blog`,
    name: `${SITE.name} Blog`,
    url: blogUrl,
    inLanguage: 'en-AU',
    publisher: {
      '@id': `${SITE.siteUrl}/#business`,
    },
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      datePublished: post.data.publishDate.toISOString(),
      dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
      url: `${SITE.siteUrl}/blog/${getPostSlug(post)}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${blogUrl}#collection`,
    name: `${SITE.name} Blog`,
    url: blogUrl,
    isPartOf: {
      '@id': `${SITE.siteUrl}/#website`,
    },
    about: {
      '@id': `${blogUrl}#blog`,
    },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: posts.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `${SITE.siteUrl}/blog/${getPostSlug(post)}`,
        name: post.data.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: `${SITE.siteUrl}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blog',
        item: blogUrl,
      },
    ],
  },
];
---

<PageLayout
  meta={meta}
  structuredData={structuredData}
  heroTitle="Blog"
  heroDescription="Launch stories, brand strategy insights, and practical marketing advice for small businesses."
  heroCtaLabel="Contact Us"
  heroCtaHref="/contact"
  heroImage={{ src: headshotBridge, alt: 'Splendid Wren brand imagery', wrapperClass: 'mx-auto w-3/5' }}
>
  <Section>
    <Container>
      {posts.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2">
          {posts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              href={`/blog/${getPostSlug(post)}`}
              publishDate={post.data.publishDate}
              image={BLOG_IMAGES[getPostSlug(post)]?.image}
              imageAlt={BLOG_IMAGES[getPostSlug(post)]?.imageAlt}
            />
          ))}
        </div>
      ) : (
        <div class="mx-auto max-w-3xl rounded-xl border border-neutral-200 bg-white p-8 text-center shadow-card">
          <Heading level={2}>New articles coming soon</Heading>
          <Text class="mt-3 text-body">
            We are preparing practical, human-focused marketing insights for small business owners.
          </Text>
        </div>
      )}
    </Container>
  </Section>

  <Section>
    <Container class="max-w-4xl text-center">
      <Heading level={2}>Follow Us On Social Media</Heading>
      <SocialLinks variant="large" class="mt-8" />
    </Container>
  </Section>

  <CtaBanner />
</PageLayout>
