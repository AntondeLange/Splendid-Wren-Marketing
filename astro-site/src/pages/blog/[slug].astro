---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/primitives/Container.astro';
import Heading from '../../components/primitives/Heading.astro';
import Section from '../../components/primitives/Section.astro';
import Text from '../../components/primitives/Text.astro';
import { BLOG_IMAGES } from '../../lib/blogImages';
import { SITE, buildAbsoluteUrl } from '../../lib/site';

interface Props {
  post: CollectionEntry<'blog'>;
}

const getPostSlug = (post: CollectionEntry<'blog'>) => post.id.replace(/\.(md|mdx)$/i, '');

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/i, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const postSlug = getPostSlug(post);

const canonicalUrl = buildAbsoluteUrl(`/blog/${postSlug}`);
const postUpdatedAt = (post.data.updatedDate ?? post.data.publishDate).toISOString();
const articleKeywords = [...new Set([...post.data.tags, 'small business marketing', 'australia'])];

const meta = {
  title: post.data.title,
  description: post.data.description,
  canonicalPath: `/blog/${postSlug}`,
  ogType: 'article' as const,
  keywords: articleKeywords,
  publishedTime: post.data.publishDate.toISOString(),
  modifiedTime: postUpdatedAt,
  articleSection: 'Blog',
  articleTags: post.data.tags,
};

const formattedDate = post.data.publishDate.toLocaleDateString('en-AU', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

const postImage = BLOG_IMAGES[postSlug];
const postImageUrl = postImage ? buildAbsoluteUrl(postImage.image.src) : buildAbsoluteUrl(SITE.defaultOgImage);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${canonicalUrl}#article`,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishDate.toISOString(),
    dateModified: postUpdatedAt,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonicalUrl,
    },
    image: [postImageUrl],
    inLanguage: 'en-AU',
    keywords: post.data.tags,
    articleSection: 'Marketing',
    author: {
      '@type': 'Organization',
      name: SITE.name,
    },
    publisher: {
      '@id': `${SITE.siteUrl}/#business`,
    },
    isPartOf: {
      '@id': `${SITE.siteUrl}/#website`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: buildAbsoluteUrl('/'),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blog',
        item: buildAbsoluteUrl('/blog'),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: post.data.title,
        item: canonicalUrl,
      },
    ],
  },
];
---

<BaseLayout meta={meta} structuredData={structuredData}>
  <Section tone="white">
    <Container class="max-w-3xl">
      <a href="/blog" class="text-sm font-medium text-brand-700 hover:text-brand-900">Back to Blog</a>
      <article class="mt-6">
        <Heading level={1}>{post.data.title}</Heading>
        <Text class="mt-3 text-sm" muted>{formattedDate}</Text>
        {
          postImage && (
            <Image
              src={postImage.image}
              alt={postImage.imageAlt}
              widths={[768, 1100]}
              sizes="(min-width: 1024px) 768px, 100vw"
              class="mt-6 w-full rounded-xl object-cover shadow-card"
              loading="lazy"
            />
          )
        }
        <Text class="mt-6 text-body">{post.data.description}</Text>

        <div
          class="mt-8 space-y-5 text-base leading-relaxed text-neutral-700 [&_h2]:mt-8 [&_h2]:text-2xl [&_h2]:font-bold [&_h3]:mt-6 [&_h3]:text-xl [&_h3]:font-semibold [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-5 [&_p]:leading-relaxed [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5"
        >
          <Content />
        </div>
      </article>
    </Container>
  </Section>
</BaseLayout>
