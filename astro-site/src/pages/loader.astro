---
import { GOOGLE_ANALYTICS_MEASUREMENT_ID } from '../lib/site';

const refreshDelaySeconds = 5;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GOOGLE_ANALYTICS_MEASUREMENT_ID}`}></script>
    <script is:inline defer src="/scripts/ga-init.js" data-ga-id={GOOGLE_ANALYTICS_MEASUREMENT_ID}></script>
    <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>Logo Loader</title>
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #ffffff;
      }

      body {
        display: grid;
        place-items: center;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        border: 0;
      }

      .loader-shell {
        position: relative;
        display: grid;
        place-items: center;
        width: 100%;
        min-height: 100vh;
      }

      .loader {
        width: min(480px, 90vw);
      }

      .loader img {
        display: block;
        width: 100%;
        height: auto;
      }

      .loader-actions {
        position: absolute;
        right: 1rem;
        bottom: 1rem;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
      }

      .loader-link {
        border: 1px solid #1e3a5f;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.94);
        color: #1e3a5f;
        font-size: 0.875rem;
        font-weight: 600;
        line-height: 1;
        text-decoration: none;
        padding: 0.6rem 0.95rem;
      }

      .loader-link:hover {
        background: #1e3a5f;
        color: #ffffff;
      }

      .loader-link:focus-visible {
        outline: 2px solid #4479bf;
        outline-offset: 2px;
      }
    </style>
    <script is:inline src="/scripts/loader-reduced-motion.js"></script>
  </head>
  <body data-loader-seconds={refreshDelaySeconds}>
    <main class="loader-shell" aria-labelledby="loader-heading">
      <h1 id="loader-heading" class="sr-only">Splendid Wren Marketing intro screen</h1>
      <p id="loader-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>
      <div class="loader">
        <img src="/media/logo-loader.svg" alt="Splendid Wren Marketing" width="431" height="357" />
      </div>
      <div class="loader-actions">
        <a href="/?from=loader" class="loader-link">Skip intro</a>
        <button type="button" class="loader-link" data-loader-extend>Stay longer</button>
      </div>
    </main>
  </body>
</html>
