---
const refreshDelaySeconds = 5;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-TBWM98H36R"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-TBWM98H36R');
    </script>
    <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <meta http-equiv="refresh" content={`${refreshDelaySeconds};url=/?from=loader`} />
    <title>Logo Loader</title>
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #ffffff;
      }

      body {
        display: grid;
        place-items: center;
      }

      .loader {
        width: min(480px, 90vw);
      }

      .loader img {
        display: block;
        width: 100%;
        height: auto;
      }
    </style>
    <script is:inline>
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        window.location.replace('/?from=loader');
      }
    </script>
  </head>
  <body>
    <div class="loader">
      <img src="/media/logo-loader.svg" alt="Splendid Wren Marketing" width="431" height="357" />
    </div>
  </body>
</html>
