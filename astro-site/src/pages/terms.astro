---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/primitives/Container.astro';
import Heading from '../components/primitives/Heading.astro';
import Section from '../components/primitives/Section.astro';
import Text from '../components/primitives/Text.astro';

const meta = {
  title: 'Terms Of Use',
  description: 'Terms of use for Splendid Wren Marketing.',
  canonicalPath: '/terms',
};
---

<BaseLayout meta={meta}>
  <Section tone="white">
    <Container class="max-w-3xl">
      <Heading level={1}>Terms Of Use</Heading>
      <Text class="mt-5 text-body">
        These Terms of Use govern access to and use of the Splendid Wren Marketing website. By using this
        site, you agree to these terms.
      </Text>

      <div class="mt-8 space-y-6">
        <section>
          <Heading level={2} class="text-2xl">Website use</Heading>
          <Text class="mt-3">All content is provided for general information only and may change without notice.</Text>
        </section>

        <section>
          <Heading level={2} class="text-2xl">Intellectual property</Heading>
          <Text class="mt-3">
            All content, branding, and materials are the property of Splendid Wren Marketing unless stated otherwise.
          </Text>
        </section>

        <section>
          <Heading level={2} class="text-2xl">Limitation of liability</Heading>
          <Text class="mt-3">We are not liable for any loss arising from use of this website or its content.</Text>
        </section>

        <section>
          <Heading level={2} class="text-2xl">Contact</Heading>
          <Text class="mt-3">Questions? Email hello@splendidwrenmarketing.com.au.</Text>
        </section>
      </div>
    </Container>
  </Section>
</BaseLayout>
