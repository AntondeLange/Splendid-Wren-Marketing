---
import { SOCIAL_LINKS } from '../lib/site';
import SocialIcon from './SocialIcon.astro';

interface Props {
  class?: string;
  variant?: 'default' | 'large';
}

const { class: className = '', variant = 'default' } = Astro.props;
const large = variant === 'large';
---

<ul class:list={['flex items-center gap-3', large && 'justify-center gap-6', className]}>
  {SOCIAL_LINKS.map((item) => (
    <li>
        <a
          href={item.href}
          aria-label={item.label}
          data-track-location={large ? 'social_large' : 'social_default'}
          class:list={[
            'inline-flex items-center justify-center rounded-full border border-brand-700/40 text-brand-700 transition hover:border-brand-900 hover:text-brand-900',
          large ? 'size-20 sm:size-24' : 'size-12',
        ]}
      >
        <SocialIcon icon={item.icon} class={large ? 'size-9 sm:size-10' : 'size-6'} />
      </a>
    </li>
  ))}
</ul>
