---
interface Props {
  href: string;
  class?: string;
  external?: boolean;
  ariaLabel?: string;
}

const { href, class: className = '', external = false, ariaLabel } = Astro.props;
---

<a
  href={href}
  aria-label={ariaLabel}
  target={external ? '_blank' : undefined}
  rel={external ? 'noreferrer noopener' : undefined}
  class:list={['font-medium text-brand-800 underline decoration-brand-300 underline-offset-4 hover:text-brand-950', className]}
>
  <slot />
</a>
