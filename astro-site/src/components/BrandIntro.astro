<dialog data-brand-intro aria-label="Splendid Wren Marketing introduction">
  <div class="intro-content">
    <img data-brand-intro-image src="/media/logo-loader.webp" alt="Splendid Wren Marketing" width="480" height="480" />
    <a href="#main-content" data-intro-skip>Skip intro</a>
  </div>
</dialog>

<style>
  dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: white;
    color: #1e3a5f;
  }
  dialog::backdrop { background: white; }
  .intro-content { min-height: 100%; display: grid; place-content: center; justify-items: center; gap: 1.5rem; padding: 1rem; }
  img { width: min(480px, 85vw, 65vh); height: auto; }
  dialog[open] img { animation: brand-reveal 1.6s ease-out both; }
  a { border: 1px solid currentColor; border-radius: 999px; padding: 0.75rem 1.25rem; font: 600 1rem/1.2 system-ui, sans-serif; text-decoration: none; }
  a:hover { background: #1e3a5f; color: white; }
  a:focus-visible { outline: 3px solid #4479bf; outline-offset: 4px; }
  @keyframes brand-reveal {
    from { opacity: 0; clip-path: inset(0 100% 0 0); }
    to { opacity: 1; clip-path: inset(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    dialog[open] img { animation: none; }
  }
</style>

<script is:inline src="/scripts/brand-intro.js"></script>
