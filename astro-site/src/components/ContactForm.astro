---
import { COMPANY_EMAIL, SOCIAL_LINKS } from '../lib/site';
import Button from './primitives/Button.astro';
import Card from './primitives/Card.astro';
import FormField from './FormField.astro';
import SocialIcon from './SocialIcon.astro';
import Text from './primitives/Text.astro';
---

<div class="grid w-full gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.08fr)] lg:items-stretch">
  <aside class="flex h-full min-w-0 flex-col justify-between rounded-3xl border border-white/20 bg-brand-950/35 p-6 text-white shadow-glow backdrop-blur-[2px] md:p-8">
    <div>
      <h1 class="font-accent text-[clamp(2.35rem,5vw,4.75rem)] leading-[0.95] text-white">
        Let&apos;s Build A<br />
        Remarkable Brand Together
      </h1>
      <p class="mt-6 max-w-xl text-[clamp(1.12rem,2vw,1.95rem)] leading-relaxed text-white/90">
        Share your goals, current challenges, and where you want your business to go next. We will guide each step
        with practical strategy and clear direction.
      </p>
      <p class="mt-10 text-lg leading-relaxed text-white/90 sm:text-xl">
        Email us at
        <span class="mt-1 block max-w-full whitespace-nowrap text-[clamp(0.86rem,3.2vw,1.32rem)] font-semibold leading-tight tracking-[-0.01em]">
          {COMPANY_EMAIL}
        </span>
      </p>
    </div>

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      <div>
        <h2 class="font-accent text-[2rem] italic text-brand-200">Location</h2>
        <p class="mt-3 text-lg leading-relaxed text-white/90">
          Based in Australia
          <br />
          Supporting small businesses nationwide
        </p>
      </div>
      <div>
        <h2 class="font-accent text-[2rem] italic text-brand-200">Social Media</h2>
        <ul class="mt-4 flex items-center gap-3">
          {SOCIAL_LINKS.map((item) => (
            <li>
              <a
                href={item.href}
                aria-label={item.label}
                class="inline-flex size-12 items-center justify-center rounded-lg border border-brand-200/80 text-brand-100 transition hover:bg-brand-100/12"
              >
                <SocialIcon icon={item.icon} class="size-6" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </aside>

  <Card hover={false} class="h-full min-w-0 rounded-3xl border border-brand-200 bg-white/95 p-5 shadow-glow sm:p-8 md:p-10">
    <header class="mb-7 space-y-4">
      <h2 class="font-accent text-[clamp(2.15rem,4.1vw,3.8rem)] leading-[0.98] text-brand-900">
        Tell Us About Your Vision
      </h2>
      <p class="max-w-2xl text-body text-neutral-700">
        Our team is ready to listen and guide every detail, big or small.
      </p>
    </header>

    <p
      data-form-status
      class="mb-4 hidden rounded-lg border px-4 py-3 text-sm"
      aria-live="polite"
      aria-atomic="true"
    ></p>

    <form action="/api/contact" method="post" data-contact-form novalidate>
      <input type="text" name="website" autocomplete="off" tabindex={-1} class="hidden" aria-hidden="true" />
      <input type="hidden" name="formName" value="contact" />

      <div class="space-y-5">
        <FormField id="name" name="name" label="First Name" placeholder="First name" required autocomplete="name" />
        <FormField
          id="businessName"
          name="businessName"
          label="Company"
          placeholder="Company or organisation"
          required
          autocomplete="organization"
        />
        <FormField
          id="email"
          name="email"
          type="email"
          label="Email Address"
          placeholder="Email address"
          required
          autocomplete="email"
        />
        <FormField
          id="phone"
          name="phone"
          type="tel"
          label="Phone Number"
          placeholder="Your phone number"
          required
          autocomplete="tel"
        />
        <div>
          <div class="mb-2 flex items-center justify-between gap-2">
            <label for="message" class="text-sm font-medium text-brand-900">Message <span class="text-red-700">*</span></label>
            <span class="text-xs font-medium text-neutral-400" data-char-count id="message-char-count">0/200</span>
          </div>
          <FormField
            id="message"
            name="message"
            type="textarea"
            label=""
            placeholder="Tell us about your business and how we can help."
            required
            maxLength={200}
            class="[&>label]:sr-only [&>p]:mt-2"
          />
        </div>
      </div>

      <div class="mt-7 flex flex-wrap items-center gap-4">
        <Button type="submit" class="min-w-[11rem]" ariaLabel="Send contact message">Send Message</Button>
        <Text as="p" class="text-sm" muted>
          We respect your privacy. Your details are only used to respond to your enquiry.
        </Text>
      </div>
    </form>
  </Card>
</div>
<script is:inline src="/scripts/contact-form.js"></script>
