---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './primitives/Button.astro';
import Card from './primitives/Card.astro';
import Heading from './primitives/Heading.astro';
import Text from './primitives/Text.astro';

interface Props {
  title: string;
  price: string;
  priceAmount?: string;
  priceNote?: string;
  description: string;
  features: string[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, price, priceNote, description, features, image, imageAlt = '' } = Astro.props;
---

<Card class="flex h-full flex-col p-0">
  {
    image && (
      <div class="px-6 pt-6">
        <Image
          src={image}
          alt={imageAlt}
          widths={[520, 760]}
          sizes="(min-width: 1280px) 384px, (min-width: 768px) 46vw, 92vw"
          class="h-44 w-full rounded-2xl object-cover shadow-card"
          loading="lazy"
        />
      </div>
    )
  }
  <div class="flex h-full flex-col p-8">
    <Heading level={3}>{title}</Heading>
    <p class="mt-3 text-lg font-semibold text-brand-900">{price}</p>
    {priceNote && <p class="mt-1 text-xs font-medium uppercase tracking-[0.08em] text-neutral-500">{priceNote}</p>}
    <Text class="mt-3">{description}</Text>
    <ul class="mt-4 space-y-2 text-sm leading-relaxed text-neutral-700">
      {features.map((feature) => (
        <li class="flex gap-2">
          <span aria-hidden="true" class="mt-1 inline-block size-1.5 rounded-full bg-brand-700"></span>
          <span>{feature}</span>
        </li>
      ))}
    </ul>
    <Button href="/contact" variant="outline" class="mt-6 w-full justify-center">Get Started</Button>
  </div>
</Card>
