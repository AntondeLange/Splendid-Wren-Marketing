# Copy this file to `astro-site/.env.local` for local development.
# Do not commit real credentials.

SMTP_HOST=mail-au.smtp2go.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp2go-username
SMTP_PASS=your-smtp2go-password

# Optional overrides:
# CONTACT_FROM_EMAIL=Splendid Wren Website <no-reply@splendidwrenmarketing.com.au>
# CONTACT_TO_EMAIL=sarahm@splendidwrenmarketing.com.au
